          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Umless 会听出每一处 “um”、“uh” 和 “hmm”，逐条列给你，并以原始分辨率和帧率导出剪好的视频。"
          }
